# @BotFather dan olingan bot tokeni (majburiy)
BOT_TOKEN=123456789:AA...

# Google AI Studio kaliti: https://aistudio.google.com/apikey
# Ovoz -> matn va konspekt uchun. Bo'lmasa faqat matn -> ovoz ishlaydi.
GEMINI_API_KEY=

# ---- Ixtiyoriy sozlamalar ----
# Gemini modeli (standart: eng yangi Flash). Masalan: gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest
# Standart ovoz: female | male  (foydalanuvchi /ovoz bilan o'zgartira oladi)
DEFAULT_VOICE_GENDER=female
# Bundan uzun audio qabul qilinmaydi (daqiqa) — xarajatni cheklash uchun
MAX_AUDIO_MINUTES=180
# Bir vaqtda qayta ishlanadigan audio soni (qolganlari navbatda kutadi)
MAX_CONCURRENT_JOBS=4
# Ma'lumotlar bazasi papkasi
DATA_DIR=data
# O'zingizning Telegram Bot API serveringiz (2 GB gacha fayllar uchun), masalan http://localhost:8081
TELEGRAM_API_SERVER=
